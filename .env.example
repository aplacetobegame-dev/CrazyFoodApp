# Public client configuration. Safe to ship in the Expo app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only. Never prefix these with EXPO_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=replace-with-local-secret-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Worker loop. Defaults are fine for local development.
WORKER_VISIBILITY_TIMEOUT_SECONDS=30
WORKER_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=1000
PORT=8080
